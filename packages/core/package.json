{
  "name": "@readlet/core",
  "version": "0.0.0",
  "description": "Framework-agnostic document rendering, text layer and selection for the browser.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
      "require": { "types": "./dist/index.d.cts", "default": "./dist/index.cjs" }
    }
  },
  "files": ["dist", "NOTICE", "LICENSE"],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  }
}
