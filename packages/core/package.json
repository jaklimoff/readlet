{
  "name": "@readletjs/core",
  "version": "0.0.0",
  "description": "Framework-agnostic document rendering, text layer and selection for the browser.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jaklimoff/readlet.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/jaklimoff/readlet#readme",
  "bugs": "https://github.com/jaklimoff/readlet/issues",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "readlet-source": "./src/index.ts",
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "NOTICE",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "import": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.js"
        },
        "require": {
          "types": "./dist/index.d.cts",
          "default": "./dist/index.cjs"
        }
      }
    }
  }
}
