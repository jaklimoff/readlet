{
  "name": "@readletjs/pdf",
  "version": "0.1.0",
  "description": "PDF backend for Readlet, built on pdf.js.",
  "keywords": [
    "pdf",
    "pdf-viewer",
    "pdfjs",
    "text-selection",
    "text-layer",
    "document-viewer",
    "typescript",
    "pdf.js",
    "http-range",
    "s3"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jaklimoff/readlet.git",
    "directory": "packages/pdf"
  },
  "homepage": "https://github.com/jaklimoff/readlet#readme",
  "bugs": "https://github.com/jaklimoff/readlet/issues",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "readlet-source": "./src/index.ts",
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "!dist/worker-source-*.map",
    "NOTICE",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "pdfjs-dist": "~6.3.289"
  },
  "peerDependencies": {
    "@readletjs/core": "workspace:^"
  },
  "devDependencies": {
    "@readletjs/core": "workspace:^"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "import": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.js"
        },
        "require": {
          "types": "./dist/index.d.cts",
          "default": "./dist/index.cjs"
        }
      }
    }
  }
}
