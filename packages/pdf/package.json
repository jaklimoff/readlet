{
  "name": "@readlet/pdf",
  "version": "0.0.0",
  "description": "PDF backend for Readlet, built on pdf.js.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jaklimoff/readlet.git",
    "directory": "packages/pdf"
  },
  "homepage": "https://github.com/jaklimoff/readlet#readme",
  "bugs": "https://github.com/jaklimoff/readlet/issues",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "readlet-source": "./src/index.ts",
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "NOTICE",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "pdfjs-dist": "~6.3.289"
  },
  "peerDependencies": {
    "@readlet/core": "workspace:^"
  },
  "devDependencies": {
    "@readlet/core": "workspace:^"
  }
}
